# Copy to .env and fill in. Never commit .env.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. https://platform.claude.com/settings/keys
# With it, Claude models (anthropic/...) run on the Anthropic API and its credits;
# OpenRouter stays their fallback, and the route for every other model.
ANTHROPIC_API_KEY=

# https://vercel.com/account/tokens
VERCEL_TOKEN=

# Optional overrides
# SILVER_BUDGET_DAILY_USD=5
# SILVER_REVIEW_PORT=4747
